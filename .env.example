# Copy this file to .env and fill in your values.
# The server will refuse to start if any required variable is missing.

# Required
NODE_ENV=development          # 'development' | 'production' | 'test'
PORT=3001
ADMIN_SECRET=change-me-before-deploy   # CLI/curl usage: x-admin-secret header
ADMIN_PASSWORD=change-me-before-deploy # Admin dashboard login password (min 8 chars)
JWT_SECRET=change-me-to-a-random-32-char-string-minimum # Signs JWT tokens (min 32 chars)

# Optional (defaults shown)
CORS_ORIGIN=http://localhost:3000      # Comma-separated for multiple origins, e.g. https://anujgajbhiye.vercel.app,https://anujgajbhiye.dev

# Required — Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required — Cloudinary (free tier: cloudinary.com)
# Get these from Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
